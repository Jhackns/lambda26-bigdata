{
  "title": "S9 - Observabilidad del pipeline (Sensores Fisicos)",
  "uid": "s09-obs-pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Kafka Brokers",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "kafka_brokers", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Kafka Exporter Up",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "up{job=\"kafka-exporter\"}", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Kafka Broker Info",
      "type": "table",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "kafka_broker_info", "format": "table", "instant": true, "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Consumer Lag (sensores-fisicos-group)",
      "type": "timeseries",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 6},
      "targets": [{"expr": "kafka_consumergroup_lag", "refId": "A"}]
    }
  ]
}
